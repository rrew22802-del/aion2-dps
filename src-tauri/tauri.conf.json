{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBAion2 DPS",
  "mainBinaryName": "DBAion2 DPS",
  "version": "2.8.0",
  "identifier": "ru.dbaion2.dps",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DBAion2 DPS",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": true,
        "devtools": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": {
      "resources/windivert/WinDivert.dll": "WinDivert.dll",
      "resources/windivert/WinDivert64.sys": "WinDivert64.sys"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "Russian"],
        "installMode": "perMachine"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
